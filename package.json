{
  "name": "lumina-photo-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:workers && next build",
    "build:workers": "tsc scripts/blurhash-worker-only.ts scripts/thumbnail-worker-only.ts --outDir scripts --module commonjs --target es2017 --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:generate": "prisma generate",
    "db:generate:prod": "dotenv -e .env.production -- prisma generate",
    "db:push": "prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "dotenv -e .env.production -- tsx prisma/seed.ts",
    "db:migrate-to-mariadb": "tsx scripts/migrate-data.ts",
    "db:migrate:sqlite-to-mariadb": "node scripts/migrate-sqlite-to-mariadb.js",
    "db:migrate:sqlite-to-mariadb:dry-run": "node scripts/migrate-sqlite-to-mariadb.js --dry-run",
    "setup:production": "bash scripts/setup-production.sh",
    "setup:prisma-prod": "bash scripts/setup-prisma-production.sh",
    "setup:database-url": "bash scripts/construct-database-url.sh",
    "debug:env": "bash scripts/debug-env.sh",
    "worker:thumbnails:all": "tsx scripts/thumbnail-queue-worker-all.ts",
    "worker:blurhash": "tsx scripts/blurhash-worker.ts",
    "worker:exif": "tsx scripts/exif-worker.ts",
    "docker:build:prod": "docker compose -f docker-compose.prod.yml build --parallel",
    "docker:build:prod:fast": "docker compose -f docker-compose.prod.yml build --parallel --no-cache-filter builder",
    "docker:up:prod": "docker compose -f docker-compose.prod.yml up -d",
    "worker:all": "concurrently \"npm:worker:thumbnails:all\" \"npm:worker:exif\" \"npm:worker:blurhash\"",
    "seed:admin": "tsx scripts/create-initial-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/lib-storage": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@bull-board/express": "^8.1.2",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-toast": "^1.2.20",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/adm-zip": "^0.5.8",
    "@types/fluent-ffmpeg": "^2.1.28",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "bull": "^4.16.5",
    "bullmq": "^5.80.9",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.23.1",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "next-intl": "^4.13.2",
    "pgvector": "^0.3.0",
    "prisma": "^6.1.0",
    "react": "^19.2.7",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.7",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.9.2",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
